    "email": "contact@neoma-pcam.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neoma-pcam/pcam-live.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node copy-assets.js"
