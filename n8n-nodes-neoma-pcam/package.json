    "neoma",
    "pcam",
    "physical-ai",
    "ising-solver",
    "predictive-maintenance",
    "quant",
    "battery",
    "supply-chain",
    "trust-security",
    "ai-governance",
    "eu-ai-act"
  ],
  "license": "MIT",
  "homepage": "https://github.com/neoma-pcam/pcam-live",
  "author": {
